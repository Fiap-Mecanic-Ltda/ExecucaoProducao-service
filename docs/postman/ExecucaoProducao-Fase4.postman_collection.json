    {
      "name": "04 · Fluxo da execução (manual)",
      "description": "Mesmo caminho que a Saga faz pelas filas, pelas rotas manuais: entrada (IniciarDiagnostico), diagnóstico com reserva, liberação (IniciarExecucao) com baixa, reparo e finalização. Com a mensageria ligada, cada passo também publica o evento da Saga.",
      "item": [
        {
          "name": "Entrada na fila de diagnóstico",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/execucao",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "execucao"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ordemServicoId\": {{osId}},\n  \"descricaoProblema\": \"Barulho ao frear (Postman)\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"status = AguardandoDiagnostico\", () => pm.expect(pm.response.json().status).to.eql(\"AguardandoDiagnostico\"));"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"osId\", 100000 + Math.floor(Math.random() * 800000));"
                ]
              }
            }
          ]
        },
        {
          "name": "Mecânico inicia o diagnóstico",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/execucao/{{osId}}/iniciar-diagnostico",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "execucao",
                "{{osId}}",
                "iniciar-diagnostico"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status = EmDiagnostico\", () => pm.expect(pm.response.json().status).to.eql(\"EmDiagnostico\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Registra o diagnóstico (reserva)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/execucao/{{osId}}/diagnostico",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "execucao",
                "{{osId}}",
                "diagnostico"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"itens\": [\n    {\n      \"tipo\": \"Servico\",\n      \"servicoOficinaId\": {{servicoId}},\n      \"quantidade\": 1\n    },\n    {\n      \"tipo\": \"Peca\",\n      \"estoqueId\": {{pecaId}},\n      \"quantidade\": 2,\n      \"valorUnitario\": 150.0\n    }\n  ],\n  \"observacao\": \"Pastilhas no limite\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status = DiagnosticoConcluido\", () => pm.expect(pm.response.json().status).to.eql(\"DiagnosticoConcluido\"));",
                  "pm.test(\"Total = serviço + 2 peças\", () => pm.expect(pm.response.json().valorTotalItens).to.eql(420));"
                ]
              }
            }
          ]
        },
        {
          "name": "Estoque reservado",
